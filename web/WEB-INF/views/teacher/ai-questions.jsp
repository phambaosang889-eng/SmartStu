<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.List,com.smartstudy.model.Question,com.smartstudy.model.AIQuestionRequest" %><%@ include file="/WEB-INF/views/shared/start.jspf" %>
<%AIQuestionRequest previousRequest=(AIQuestionRequest)session.getAttribute("lastAIQuestionRequest");boolean defaultLive=Boolean.TRUE.equals(request.getAttribute("aiAvailable"))&&!"demo".equals(session.getAttribute("generatedMode"));%><section class="page-heading"><div><span class="eyebrow">BIÊN SOẠN CÓ KIỂM DUYỆT</span><h1>AI tạo câu hỏi</h1><p>Thiết lập → xem trước và chỉnh sửa → chọn câu → lưu vào ngân hàng.</p></div><a class="button secondary" href="<%=base%>/question-bank">Mở ngân hàng →</a></section>
<div class="notice subtle" role="status"><span class="connection-dot" aria-hidden="true"></span><span><%=Boolean.TRUE.equals(request.getAttribute("aiAvailable"))?"Đã có cấu hình AI. Bạn có thể gửi yêu cầu tạo câu hỏi.":"AI chưa được cấu hình hoặc đang tạm dừng. Ngân hàng tham khảo là bộ câu mẫu, không gọi Gemini."%></span></div>
<%if(request.getAttribute("questionError")!=null){%><div class="notice error" role="alert"><%=ViewSupport.h(request.getAttribute("questionError"))%></div><%}%>
<form class="surface editor-form" method="post" action="<%=base%>/ai-questions"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="generate"><h2>1. Thiết lập bộ câu hỏi</h2><label>Chế độ<select name="mode"><option value="demo" <%=defaultLive?"":"selected"%>>Ngân hàng tham khảo</option><option value="live" <%=Boolean.TRUE.equals(request.getAttribute("aiAvailable"))?(defaultLive?"selected":""):"disabled"%>>Google Gemini</option></select></label><div class="form-grid"><label>Chủ đề<select name="topic"><option <%=previousRequest!=null&&previousRequest.topic().equals("Định luật Newton")?"selected":""%>>Định luật Newton</option><option <%=previousRequest!=null&&previousRequest.topic().equals("Chuyển động")?"selected":""%>>Chuyển động</option><option <%=previousRequest!=null&&previousRequest.topic().equals("Năng lượng")?"selected":""%>>Năng lượng</option></select></label><label>Số câu tối đa<input type="number" name="count" value="<%=previousRequest==null?4:previousRequest.count()%>" min="1" max="10" required></label><label>Mức độ<select name="level"><option <%=previousRequest!=null&&previousRequest.level().equals("Vận dụng")?"selected":""%>>Vận dụng</option><option <%=previousRequest!=null&&previousRequest.level().equals("Nhận biết")?"selected":""%>>Nhận biết</option><option <%=previousRequest!=null&&previousRequest.level().equals("Thông hiểu")?"selected":""%>>Thông hiểu</option><option <%=previousRequest!=null&&previousRequest.level().equals("Vận dụng cao")?"selected":""%>>Vận dụng cao</option></select></label><label>Độ khó<select name="hardness"><option <%=previousRequest!=null&&previousRequest.hardness().equals("Trung bình")?"selected":""%>>Trung bình</option><option <%=previousRequest!=null&&previousRequest.hardness().equals("Dễ")?"selected":""%>>Dễ</option><option <%=previousRequest!=null&&previousRequest.hardness().equals("Khó")?"selected":""%>>Khó</option></select></label><label>Thời gian dự kiến mỗi câu (giây)<input type="number" name="seconds" min="15" max="600" value="<%=previousRequest==null?60:previousRequest.seconds()%>" required></label><label>Điểm mỗi câu<input type="number" name="points" min="1" max="10" value="<%=previousRequest==null?1:previousRequest.points()%>" required></label></div><fieldset class="question-choice" id="ai-extra"><legend>Yêu cầu dành cho trợ lý AI</legend><label>Bài học / phạm vi kiến thức<input name="lesson" value="<%=ViewSupport.h(previousRequest==null?"Vật lý 10":previousRequest.lesson())%>" maxlength="200" required></label><label>Mục tiêu học tập<textarea name="objective" maxlength="600" required><%=ViewSupport.h(previousRequest==null?"Vận dụng kiến thức đúng, ghi rõ đơn vị SI và giải thích lập luận.":previousRequest.objective())%></textarea></label><label>Yêu cầu bổ sung<textarea name="extra" maxlength="1500" rows="3"><%=ViewSupport.h(previousRequest==null?"":previousRequest.extra())%></textarea></label></fieldset><p class="muted">Chọn chủ đề và mức độ, sau đó rà soát từng câu trước khi sử dụng.</p><p>Trắc nghiệm một đáp án · Tiếng Việt. Số câu có thể ít hơn khi ngân hàng tham khảo chưa đủ nội dung phù hợp.</p><button class="button primary">Chuẩn bị bộ câu hỏi</button></form>
<%List<Question> questions=(List<Question>)session.getAttribute("generatedQuestions");if(questions!=null&&!questions.isEmpty()){%><form class="editor-form" method="post" action="<%=base%>/ai-questions" data-confirm="Lưu các câu đã chọn và chỉnh sửa vào ngân hàng? Câu trùng nội dung sẽ được bỏ qua."><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><section class="surface"><h2>2. Xem trước và chọn lọc</h2><div class="actions"><button type="button" class="button secondary" id="select-all">Chọn tất cả</button><button type="button" class="button secondary" id="select-none">Bỏ chọn tất cả</button><b id="selected-count"></b></div></section><%for(Question q:questions){%><article class="surface"><div class="card-top"><label class="check-line"><input type="checkbox" name="selected" value="<%=q.id()%>"> Chọn câu này</label><span class="badge"><%=ViewSupport.h(q.topic())%> · <%=ViewSupport.h(ViewSupport.sourceLabel(q.source()))%></span></div><%@ include file="/WEB-INF/views/shared/question-fields.jspf" %><div class="actions"><button class="button secondary" name="action" value="regenerate_<%=q.id()%>">Tạo lại câu này</button><button class="button secondary" name="action" value="remove_<%=q.id()%>" formnovalidate>Bỏ câu khỏi bộ</button></div></article><%}%><button class="button primary" name="action" value="save-selected">3. Lưu câu đã chọn vào ngân hàng</button></form><script>(()=>{const boxes=[...document.querySelectorAll('input[name=selected]')],out=document.getElementById('selected-count');const update=()=>out.textContent=boxes.filter(b=>b.checked).length+' / '+boxes.length+' câu đã chọn';document.getElementById('select-all').onclick=()=>{boxes.forEach(b=>b.checked=true);update()};document.getElementById('select-none').onclick=()=>{boxes.forEach(b=>b.checked=false);update()};boxes.forEach(b=>b.addEventListener('change',update));update()})();</script><%}%>
<script>(()=>{const mode=document.querySelector("select[name=mode]"),extra=document.getElementById("ai-extra");const sync=()=>{extra.disabled=mode.value!=="live";extra.hidden=mode.value!=="live"};mode.addEventListener("change",sync);sync();const preview=document.querySelector("form[data-confirm]");preview?.addEventListener("submit",e=>{if(e.submitter?.value!=="save-selected")delete preview.dataset.confirm;else preview.dataset.confirm="Lưu các câu đã chọn vào ngân hàng?"})})();</script><%@ include file="/WEB-INF/views/shared/end.jspf" %>
