<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" import="java.util.List,com.smartstudy.model.Question" %><%@ include file="/WEB-INF/views/shared/start.jspf" %>
<section class="page-heading"><div><span class="eyebrow">THƯ VIỆN CÂU HỎI</span><h1>Ngân hàng câu hỏi</h1><p>Chỉnh sửa, lưu trữ hoặc đưa câu hỏi đã duyệt vào quiz.</p></div><div class="actions"><a class="button secondary" href="<%=base%>/ai-questions">Chuẩn bị câu hỏi</a><a class="button primary" href="<%=base%>/quiz?mode=edit">Tạo quiz từ ngân hàng →</a></div></section>
<%if(request.getAttribute("questionError")!=null){%><div class="notice error" role="alert"><%=ViewSupport.h(request.getAttribute("questionError"))%></div><%}%>
<%@ include file="/WEB-INF/views/shared/manual-question.jspf" %><div class="toolbar"><label class="search-field"><input type="search" data-search aria-label="Tìm câu hỏi" placeholder="Tìm theo nội dung hoặc chủ đề"></label><label>Trạng thái<select data-filter><option value="all">Tất cả</option><option value="active">Đang dùng</option><option value="archived">Đã lưu trữ</option></select></label><span data-result-count></span></div>
<%List<Question> bank=(List<Question>)request.getAttribute("questionBank");for(Question q:bank){boolean archived=((Set<String>)request.getAttribute("archivedQuestions")).contains(q.id());%><article class="surface" data-search-item data-state="<%=archived?"archived":"active"%>"><span class="badge"><%=archived?"Đã lưu trữ":ViewSupport.h(ViewSupport.sourceLabel(q.source()))%></span><h2><%=ViewSupport.h(q.text())%></h2><ol><%for(String o:q.options()){%><li><%=ViewSupport.h(o)%></li><%}%></ol><p>Đáp án: <b><%=ViewSupport.h(q.options().get(q.correctIndex()))%></b> · <%=ViewSupport.h(q.topic())%> · <%=ViewSupport.h(q.difficulty())%> · <%=q.points()%> điểm</p><p><%=ViewSupport.h(q.explanation())%></p><details class="question-choice"><summary>Chỉnh sửa câu hỏi</summary><form class="editor-form" method="post" action="<%=base%>/question-bank"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="update-question"><input type="hidden" name="version" value="<%=((Map<String,Integer>)request.getAttribute("bankVersions")).get(q.id())%>"><input type="hidden" name="id" value="<%=q.id()%>"><%@ include file="/WEB-INF/views/shared/question-fields.jspf" %><button class="button primary">Lưu câu hỏi</button></form></details><form method="post" action="<%=base%>/question-bank" data-confirm="Cập nhật trạng thái câu hỏi? Quiz đã biên soạn vẫn giữ nội dung cũ."><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="<%=archived?"restore-question":"archive-question"%>"><input type="hidden" name="id" value="<%=q.id()%>"><button class="button secondary"><%=archived?"Khôi phục":"Lưu trữ"%></button></form></article><%}%><div class="empty-state" data-empty <%=bank.isEmpty()?"":"hidden"%>><h2>Chưa có câu hỏi phù hợp</h2><p>Đổi bộ lọc hoặc chuẩn bị câu hỏi rồi chọn lưu vào ngân hàng.</p><a class="button primary" href="<%=base%>/ai-questions">Chuẩn bị câu hỏi →</a></div>
<%@ include file="/WEB-INF/views/shared/end.jspf" %>
