<%@ page pageEncoding="UTF-8" %>
<%java.util.List<com.smartstudy.model.LessonVideo> lessonVideos=(java.util.List<com.smartstudy.model.LessonVideo>)request.getAttribute("lessonVideos");if(lessonVideos!=null&&!lessonVideos.isEmpty()){%>
<section class="lesson-videos" aria-label="Video bài giảng"><div class="video-heading"><div><span class="eyebrow">HỌC QUA HÌNH ẢNH</span><h2>Video bài giảng</h2></div><span class="badge"><%=lessonVideos.size()%> video</span></div>
<%for(var lessonVideo:lessonVideos){%><article class="lesson-video"><div class="video-frame"><%if(lessonVideo.type().equals("youtube")){%><iframe src="https://www.youtube-nocookie.com/embed/<%=com.smartstudy.service.LessonVideoService.youtubeId(lessonVideo.url())%>" title="<%=ViewSupport.h(lessonVideo.title())%>" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe><%}else{%><video controls preload="metadata" playsinline aria-label="<%=ViewSupport.h(lessonVideo.title())%>" src="${pageContext.request.contextPath}/media/lesson-video?id=<%=lessonVideo.id()%>">Trình duyệt chưa hỗ trợ phát video. Hãy dùng Chrome, Edge hoặc Firefox mới.</video><%}%></div><div class="video-caption"><div><h3><%=ViewSupport.h(lessonVideo.title())%></h3><p><%=ViewSupport.h(lessonVideo.source())%></p></div><%if(lessonVideo.type().equals("youtube")){%><a class="text-link" href="<%=ViewSupport.h(lessonVideo.url())%>" target="_blank" rel="noopener noreferrer">Xem trên YouTube ↗</a><%}%></div><%if(lessonVideo.type().equals("upload")){%><p class="notice error" data-video-error role="alert" hidden>Không tải được video. Hãy tải lại trang hoặc báo giáo viên kiểm tra file và định dạng video.</p><%}%><%if(lessonVideo.type().equals("youtube")){%><p class="field-help">Nếu nguồn không cho phép xem nhúng hoặc video tạm thời không khả dụng, chọn “Xem trên YouTube”.</p><%}%></article><%}%></section><%}%>

<script src="${pageContext.request.contextPath}/assets/js/lesson-video-player.js" defer></script>
