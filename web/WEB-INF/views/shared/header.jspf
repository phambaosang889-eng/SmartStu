<%@ page pageEncoding="UTF-8" %><header class="workspace-header"><div class="header-start"><button class="mobile-toggle icon-button" aria-label="Mở điều hướng" aria-controls="navigation" aria-expanded="false" type="button">☰</button><nav class="breadcrumb" aria-label="Đường dẫn"><a href="<%=base%>/dashboard">Không gian học tập</a><span>/</span><span><%=ViewSupport.h(title)%></span></nav></div><div class="header-user"><button class="theme-toggle icon-button" type="button" aria-label="Đổi giao diện sáng tối"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg></button><a href="<%=base%>/profile" aria-label="Mở hồ sơ cá nhân"><span class="user-avatar"><%=ViewSupport.h(viewer.getName().substring(0,1))%></span></a><div><b><%=ViewSupport.h(viewer.getName())%></b><small><%=ViewSupport.roleLabel(viewer)%></small></div></div></header>
