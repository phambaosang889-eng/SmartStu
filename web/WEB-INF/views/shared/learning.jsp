<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" import="com.smartstudy.model.CatalogEntry" %><%@ include file="start.jspf" %>
<%List<CatalogEntry> learning=(List<CatalogEntry>)request.getAttribute("learningItems");CatalogEntry item=(CatalogEntry)request.getAttribute("learningEntry");Set<String> completed=(Set<String>)request.getAttribute("completed");Set<String> known=(Set<String>)request.getAttribute("known");boolean cards=current.equals("flashcards");%>
<section class="page-heading"><div><span class="eyebrow">HỌC VẬT LÝ MỖI NGÀY</span><h1><%=ViewSupport.h(title)%></h1><p><%=cards?"Tự trả lời trước khi lật thẻ, sau đó đánh dấu mức độ ghi nhớ.":"Khám phá nội dung được giáo viên biên soạn và xuất bản."%></p></div><%if(item!=null&&!cards){%><a class="button secondary" href="<%=base%>/<%=current%>">← Tất cả bài học</a><%}%></section>
<%if(learning.isEmpty()){%><div class="empty-state"><h2>Chưa có học liệu trong khóa học đã tham gia</h2><p>Bạn có thể đăng ký khóa học ở mục Khóa học, hoặc chờ giáo viên xuất bản học liệu mới.</p></div><%}else if(cards){CatalogEntry prev=(CatalogEntry)request.getAttribute("previous"),next=(CatalogEntry)request.getAttribute("next");%>
<div class="split-grid"><section class="surface"><div class="card-top"><span class="badge"><%=ViewSupport.h(item.topic())%></span><span class="field-help">Thẻ <%=((Integer)request.getAttribute("itemIndex"))+1%> / <%=learning.size()%></span></div><div class="flash-study"><span class="eyebrow">CÂU HỎI</span><h2><%=ViewSupport.h(item.title())%></h2><button class="button secondary" type="button" id="flip-button" aria-expanded="false" aria-controls="card-answer">Lật thẻ ↻</button><div id="card-answer" hidden><hr><span class="eyebrow">CÂU TRẢ LỜI</span><p class="prose"><%=ViewSupport.h(item.body())%></p></div></div><div class="actions flashcard-navigation"><a class="button secondary" aria-label="Thẻ trước" href="<%=base%>/flashcards?id=<%=prev.id()%>">←</a><a class="button secondary" href="<%=base%>/flashcards?shuffle=1">Trộn thẻ</a><a class="button secondary" aria-label="Thẻ tiếp theo" href="<%=base%>/flashcards?id=<%=next.id()%>">→</a></div><form method="post" class="form-footer" action="<%=base%>/flashcards"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="mark-card"><input type="hidden" name="id" value="<%=item.id()%>"><button class="button secondary" name="state" value="practice">Cần ôn lại</button><button class="button primary" name="state" value="known">✓ Đã nhớ</button></form></section><aside class="surface"><h2>Tiến độ bộ thẻ</h2><%long remembered=learning.stream().filter(c->known.contains(c.id())).count();%><div class="card-metric"><strong><%=remembered%>/<%=learning.size()%></strong><span>thẻ đã nhớ</span></div><progress value="<%=remembered%>" max="<%=learning.size()%>" aria-label="Thẻ đã nhớ"></progress><p><%=known.contains(item.id())?"Bạn đã đánh dấu nhớ thẻ hiện tại.":"Thẻ hiện tại cần được ôn lại."%></p><p class="field-help">Tiến độ được lưu theo tài khoản của bạn.</p></aside></div><script>document.getElementById('flip-button').addEventListener('click',function(){const a=document.getElementById('card-answer');a.hidden=!a.hidden;this.setAttribute('aria-expanded',String(!a.hidden));this.textContent=a.hidden?'Lật thẻ ↻':'Ẩn câu trả lời';});</script>
<%}else if(item!=null){CatalogEntry prev=(CatalogEntry)request.getAttribute("previous"),next=(CatalogEntry)request.getAttribute("next");%><article class="surface reading"><span class="badge"><%=ViewSupport.h(item.topic())%></span><h2><%=ViewSupport.h(item.title())%></h2><%@ include file="lesson-videos.jspf" %><div class="prose"><%=ViewSupport.h(item.body())%></div><%var linked=com.smartstudy.service.CourseService.getInstance().placement(item.id());if(linked!=null&&!linked.resourceUrl().isBlank()){%><a class="button secondary" target="_blank" rel="noopener noreferrer" href="<%=ViewSupport.h(linked.resourceUrl())%>">Mở tài liệu / video nguồn ↗</a><%}if(current.equals("lesson")){%><script>(()=>{const data=new URLSearchParams({action:"study-pulse",id:"<%=item.id()%>",csrf:"<%=ViewSupport.csrf(request)%>"});setInterval(()=>{if(document.visibilityState==="visible")fetch(location.pathname,{method:"POST",body:data,credentials:"same-origin"}).catch(()=>{})},30000)})();</script><form method="post" action="<%=base%>/lesson" class="form-footer"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="complete"><input type="hidden" name="id" value="<%=item.id()%>"><a class="button secondary" href="<%=base%>/quiz">Làm quiz</a><button class="button primary" type="submit"><%=completed.contains(item.id())?"✓ Đã hoàn thành":"Đánh dấu hoàn thành"%></button></form><nav class="form-footer" aria-label="Bài trước và tiếp theo"><a class="text-link" href="<%=base%>/lesson?id=<%=prev.id()%>">← <%=ViewSupport.h(prev.title())%></a><a class="text-link" href="<%=base%>/lesson?id=<%=next.id()%>"><%=ViewSupport.h(next.title())%> →</a></nav><%}%></article>
<%}else{%><div class="toolbar"><label class="search-field"><span>⌕</span><input data-search type="search" aria-label="Tìm nội dung học tập" placeholder="Tìm tên bài hoặc chủ đề"></label><span data-result-count class="result-count"><%=learning.size()%> nội dung</span></div><div class="resource-grid"><%for(CatalogEntry e:learning){%><article class="resource-card" data-search-item><div class="card-top"><span class="badge"><%=ViewSupport.h(e.topic())%></span><%if(completed.contains(e.id())){%><span class="badge published">✓ Hoàn thành</span><%}%></div><h2><%=ViewSupport.h(e.title())%></h2><p class="clamp"><%=ViewSupport.h(e.body())%></p><a class="button secondary" href="<%=base%>/<%=current.equals("courses")?"lesson":current%><%=current.equals("courses")?"":"?id="+e.id()%>"><%=current.equals("courses")?"Xem bài học":"Đọc nội dung →"%></a></article><%}%></div><div class="empty-state" data-empty hidden><h2>Không tìm thấy nội dung</h2><p>Thử một từ khóa ngắn hơn hoặc xóa bộ lọc.</p></div><%}%><%@ include file="end.jspf" %>
