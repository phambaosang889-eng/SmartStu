<%@ page pageEncoding="UTF-8" %>
<section class="surface video-manager" id="lesson-video-manager"><div class="video-heading"><div><span class="eyebrow">HỌC LIỆU TRỰC QUAN</span><h2>Video bài giảng</h2><p>Thêm video vào bài học đã lưu. Nội dung văn bản được lưu riêng bằng nút Lưu nội dung.</p></div><span class="badge">YouTube · MP4 · WebM</span></div>
<%if(entry==null){%><div class="empty-state compact"><h3>Lưu bài học để thêm video</h3><p>Sau khi lưu, mở lại Chỉnh sửa để thêm nguồn YouTube hoặc tải video của bạn lên.</p></div><%}else{%>
<%java.util.List<com.smartstudy.model.LessonVideo> managedVideos=(java.util.List<com.smartstudy.model.LessonVideo>)request.getAttribute("lessonVideos");if(managedVideos!=null)for(var managedVideo:managedVideos){%><div class="video-file-row"><div><strong><%=ViewSupport.h(managedVideo.title())%></strong><p><%=ViewSupport.h(managedVideo.source())%> · <%=managedVideo.type().equals("youtube")?"YouTube":String.format(java.util.Locale.ROOT,"%.1f MB",managedVideo.bytes()/1048576.0)%></p></div><form method="post" action="<%=base%>/lesson-video" data-confirm="Ẩn video này khỏi bài học? File và dữ liệu cũ vẫn được giữ."><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="lesson" value="<%=entry.id()%>"><input type="hidden" name="id" value="<%=managedVideo.id()%>"><input type="hidden" name="action" value="archive-video"><button class="button secondary">Ẩn video</button></form></div><%}%>
<div class="video-manager-grid"><form method="post" action="<%=base%>/lesson-video" class="video-add-form"><h3>Gắn video YouTube</h3><p>Dùng liên kết video công khai và ghi rõ tác giả hoặc đơn vị cung cấp.</p><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="lesson" value="<%=entry.id()%>"><input type="hidden" name="action" value="link-video"><label>Tên video<input type="text" name="title" maxlength="200" required></label><label>Liên kết YouTube<input type="url" name="url" maxlength="1000" placeholder="https://www.youtube.com/watch?v=…" required></label><label>Tác giả / nguồn<input type="text" name="source" maxlength="200" required></label><button class="button primary">Thêm video YouTube</button></form>
<form method="post" action="<%=base%>/lesson-video" enctype="multipart/form-data" class="video-add-form" data-video-upload><h3>Tải video của bạn lên</h3><p>MP4 (H.264/AAC) hoặc WebM, tối đa 200 MB/video. Video giữ nguyên sau khi triển khai lại ứng dụng.</p><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="lesson" value="<%=entry.id()%>"><input type="hidden" name="action" value="upload-video"><label>Tên video<input type="text" name="title" maxlength="200" required></label><label>Chọn file video<input type="file" name="video" accept="video/mp4,video/webm,.mp4,.webm" required></label><label class="check-line"><input type="checkbox" name="rights" required> Tôi có quyền sử dụng và chia sẻ video này cho học sinh.</label><p class="field-help" data-upload-status role="status">File được kiểm tra định dạng và chỉ người có quyền học mới xem được.</p><button class="button primary">Tải video lên</button></form></div><a class="text-link" href="<%=base%>/lesson?id=<%=entry.id()%>">Xem trước bài học và video →</a><%}%></section><script src="${pageContext.request.contextPath}/assets/js/lesson-video.js" defer></script>
