<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" import="com.smartstudy.service.EssayWorkflow.*" %><%@ include file="start.jspf" %>
<%com.smartstudy.model.EssayPhoto essayPhoto=(com.smartstudy.model.EssayPhoto)request.getAttribute("essayPhoto");boolean student=viewer.getRole()==Role.STUDENT;Assignment assignment=(Assignment)request.getAttribute("assignment");Submission submission=(Submission)request.getAttribute("submission");boolean edit=!student&&("edit".equals(request.getParameter("mode"))||"save-assignment".equals(request.getParameter("action")));boolean error=request.getAttribute("essayError")!=null;%>
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/essay-photo.css?v=20261030-ux2"><section class="page-heading"><div><span class="eyebrow">TỰ LUẬN & PHẢN HỒI</span><h1><%=edit?"Biên soạn bài tự luận":submission!=null?"Bài nộp và kết quả":assignment!=null?ViewSupport.h(assignment.title()):"Bài tự luận"%></h1><p>Trình bày cách hiểu, lập luận và nhận phản hồi theo từng tiêu chí.</p></div><a class="button secondary" href="<%=base%>/essays">Danh sách bài</a><%if(!student&&!edit){%><a class="button primary" href="<%=base%>/essays?mode=edit">＋ Giao bài mới</a><%}%></section>
<%if(error){%><div class="notice error" role="alert"><%=ViewSupport.h(request.getAttribute("essayError"))%></div><%}%>
<%if(edit){String rubric=assignment==null?"Kiến thức và công thức | 3\nTính toán | 3\nĐơn vị và lập luận | 4":String.join("\n",assignment.rubric().stream().map(c->c.title()+" | "+c.max()).toList());%>
<form method="post" action="<%=base%>/essays" class="surface editor-form"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="save-assignment"><input type="hidden" name="id" value="<%=assignment==null?"":assignment.id()%>"><input type="hidden" name="version" value="<%=assignment==null?0:assignment.version()%>">
<%@ include file="essay-course.jspf" %><label>Tên bài<input name="title" maxlength="150" required value="<%=ViewSupport.h(error?request.getParameter("title"):assignment==null?"":assignment.title())%>"></label>
<label>Đề bài<textarea name="prompt" rows="5" maxlength="6000" required><%=ViewSupport.h(error?request.getParameter("prompt"):assignment==null?"":assignment.prompt())%></textarea></label>
<label>Hướng dẫn và mục tiêu<textarea name="instructions" rows="3" maxlength="3000" required><%=ViewSupport.h(error?request.getParameter("instructions"):assignment==null?"":assignment.instructions())%></textarea></label>
<label>Đáp án tham khảo (hiện sau khi công bố điểm)<textarea name="reference" rows="4" maxlength="6000" required><%=ViewSupport.h(error?request.getParameter("reference"):assignment==null?"":assignment.reference())%></textarea></label>
<label>Rubric — mỗi dòng: tên tiêu chí | điểm tối đa<textarea name="rubric" rows="5" maxlength="2000" required><%=ViewSupport.h(error?request.getParameter("rubric"):rubric)%></textarea></label><p class="muted">Từ 1 đến 10 tiêu chí, tổng tối đa 100 điểm. Mỗi lần nộp lưu lại đề và rubric tại thời điểm nộp.</p>
<div class="form-grid"><label>Hạn nộp (bỏ trống nếu không giới hạn)<input type="date" name="deadline" value="<%=ViewSupport.h(error?request.getParameter("deadline"):assignment==null?"":assignment.deadline())%>"></label><label>Trạng thái<select name="status"><option value="draft">Bản nháp</option><option value="published" <%=assignment!=null&&assignment.published()?"selected":""%>>Mở cho học sinh</option></select></label></div><button class="button primary">Lưu đề và rubric</button></form>
<%}else if(submission!=null){Assignment a=submission.assignment();Review review=student?submission.visible():submission.latest();com.smartstudy.model.EssayGradingResult suggestion=com.smartstudy.service.EssayWorkflow.getInstance().suggestion(submission.id(),viewer);%>
<section class="surface"><span class="badge"><%=submission.visible()!=null?"Đã công bố":submission.latest()!=null?"Đã chấm · chưa công bố":"Chờ giáo viên chấm"%></span><h2><%=ViewSupport.h(a.title())%></h2><p><%=ViewSupport.h(a.prompt())%></p><p class="muted"><%=ViewSupport.h(submission.email())%> · <%=ViewSupport.date(submission.at())%></p><h3>Bài làm đã nộp</h3><div class="prose"><%=ViewSupport.h(submission.answer())%></div></section>
<%if(essayPhoto!=null){%><%@ include file="essay-photo.jspf" %><%}%>
<%if(review!=null){%><section class="surface"><h2><%=student?"Kết quả giáo viên đã công bố":"Lần chấm gần nhất"%> · <%=review.total()%>/<%=a.maximum()%></h2><%for(int i=0;i<a.rubric().size();i++){%><div class="activity-row"><b><%=ViewSupport.h(a.rubric().get(i).title())%></b><span><%=review.scores().get(i)%>/<%=a.rubric().get(i).max()%></span></div><%}%><h3>Nhận xét</h3><div class="prose"><%=ViewSupport.h(review.feedback())%></div><h3>Đáp án tham khảo</h3><div class="prose"><%=ViewSupport.h(a.reference())%></div></section><%}else if(student){%><div class="notice">Bài đã được lưu. Giáo viên sẽ chấm, duyệt và công bố kết quả tại đây.</div><%}%>
<%if(!student){%><form class="surface editor-form" method="post" action="<%=base%>/essays" data-confirm="Lưu kết quả theo trạng thái bạn đã chọn?"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="review"><input type="hidden" name="submission" value="<%=submission.id()%>"><input type="hidden" name="version" value="<%=submission.reviews().size()%>"><h2>Chấm theo rubric</h2><%int i=0;for(Criterion c:a.rubric()){%><label><%=ViewSupport.h(c.title())%> (tối đa <%=c.max()%>)<input name="score_<%=i%>" type="number" step="0.1" min="0" max="<%=c.max()%>" required value="<%=ViewSupport.h(error?request.getParameter("score_"+i):review==null?suggestion==null?"":suggestion.scores().get(i):review.scores().get(i))%>"></label><%i++;}%><label>Nhận xét: dẫn chiếu bài làm, điểm đúng, thiếu sót và cách cải thiện<textarea name="feedback" rows="6" maxlength="6000" required><%=ViewSupport.h(error?request.getParameter("feedback"):review==null?suggestion==null?"":suggestion.feedback():review.feedback())%></textarea></label><label>Trả kết quả<select name="status"><option value="draft">Lưu để rà soát (học sinh chưa thấy)</option><option value="published">Duyệt và công bố cho học sinh</option></select></label><button class="button primary">Lưu kết quả chấm</button></form>
<section class="surface"><h2>AI hỗ trợ chấm theo rubric</h2><p><%=com.smartstudy.service.AIService.getInstance().available()?"Dịch vụ nhận đề, rubric, bài làm và ảnh đính kèm (nếu có) để chỉ ra lỗi sai. Ảnh được gửi đến Google Gemini; không gửi thêm thông tin tài khoản. Điểm đề xuất cần giáo viên rà soát và công bố.":"Chưa cấu hình hoặc dịch vụ đang tạm dừng. Bạn có thể chấm thủ công theo rubric ở trên."%></p><form method="post" action="<%=base%>/essays"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="ai-review"><input type="hidden" name="submission" value="<%=submission.id()%>"><button class="button secondary">Yêu cầu AI hỗ trợ chấm</button></form><%if(suggestion!=null){%><div class="notice"><b>Đề xuất AI: <%=suggestion.total()%>/<%=a.maximum()%> · Độ tin cậy <%=Math.round(suggestion.confidence()*100)%>%</b><span>Cần giáo viên xem lại. Điểm này chưa phải điểm công bố.</span></div><div class="prose"><%=ViewSupport.h(suggestion.feedback())%></div><%}%><a class="text-link" href="<%=base%>/ai-settings">Xem trạng thái cấu hình →</a></section>
<section class="surface"><h2>Lịch sử chấm và điều chỉnh</h2><%if(submission.reviews().isEmpty()){%><p>Chưa có lần chấm nào.</p><%}for(Review r:submission.reviews()){%><details class="question-choice"><summary><%=ViewSupport.date(r.at())%> · <%=r.total()%> điểm · <%=r.published()?"Công bố":"Chưa công bố"%></summary><p>Người sửa: <%=ViewSupport.h(r.reviewer())%></p><p><%=ViewSupport.h(r.feedback())%></p></details><%}%></section><%}%>
<%}else if(assignment!=null){%><section class="surface"><span class="badge"><%=assignment.published()?"Đang mở":"Bản nháp"%></span><h2>Đề bài</h2><div class="prose"><%=ViewSupport.h(assignment.prompt())%></div><h3>Hướng dẫn</h3><div class="prose"><%=ViewSupport.h(assignment.instructions())%></div><p>Hạn nộp: <%=assignment.deadline()==null?"Không giới hạn":assignment.deadline()%> · Thang điểm: <%=assignment.maximum()%></p><h3>Tiêu chí đánh giá</h3><%for(Criterion c:assignment.rubric()){%><div class="activity-row"><span><%=ViewSupport.h(c.title())%></span><b><%=c.max()%> điểm</b></div><%}%><%if(!student){%><a class="button primary" href="<%=base%>/essays?mode=edit&id=<%=assignment.id()%>">Sửa đề / rubric</a><%}%></section>
<%if(student){%><%@ include file="essay-photo.jspf" %><form class="surface editor-form" method="post" action="<%=base%>/essays" id="essay-form"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="id" value="<%=assignment.id()%>"><input type="hidden" name="token" value="<%=session.getAttribute("essayToken")%>"><label><%=essayPhoto==null?"Câu trả lời":"Câu trả lời bổ sung (có thể để trống khi đã đính kèm ảnh)"%><textarea id="essay-answer" name="answer" rows="12" <%=essayPhoto==null?"minlength=\"20\" required":""%> maxlength="12000" data-counter="essay-count"><%=ViewSupport.h(error?request.getParameter("answer"):request.getAttribute("draft"))%></textarea></label><span id="essay-count"></span><p class="muted" id="draft-state">Tự lưu bản nháp trên thiết bị này. Bấm Lưu bản nháp để lưu trên máy chủ.</p><div class="actions"><button class="button secondary" name="action" value="draft" formnovalidate>Lưu bản nháp</button><button class="button primary" name="action" value="submit" id="essay-submit">Nộp bài</button></div></form>
<script>(()=>{const t=document.getElementById('essay-answer'),form=document.getElementById('essay-form'),key='smartstu-essay-'+<%=Math.abs(viewer.getEmail().hashCode())%>+'-<%=assignment.id()%>';try{if(!t.value)t.value=localStorage.getItem(key)||''}catch(e){}t.addEventListener('input',()=>{try{localStorage.setItem(key,t.value);document.getElementById('draft-state').textContent='Đã tự lưu trên thiết bị này.'}catch(e){document.getElementById('draft-state').textContent='Không thể lưu trên thiết bị. Hãy dùng nút Lưu bản nháp.'}});form.addEventListener('submit',e=>{if(e.submitter?.value==='submit'){form.dataset.confirm='Nộp bài làm này để giáo viên chấm? Bạn vẫn có thể nộp lần làm mới sau đó.'}else delete form.dataset.confirm;});})();</script><%}%>
<%}else{List<Assignment> assignments=(List<Assignment>)request.getAttribute("assignments");%><div class="resource-grid"><%for(Assignment a:assignments){%><article class="resource-card"><span class="badge"><%=a.published()?"Đang mở":"Bản nháp"%></span><h2><%=ViewSupport.h(a.title())%></h2><p><%=ViewSupport.h(a.instructions())%></p><p><%=a.rubric().size()%> tiêu chí · <%=a.maximum()%> điểm</p><a class="button secondary" href="<%=base%>/essays?id=<%=a.id()%>"><%=student?"Xem đề / làm bài →":"Xem đề / chỉnh sửa →"%></a></article><%}%></div><%if(assignments.isEmpty()){%><div class="empty-state"><h2>Chưa có bài tự luận</h2><p><%=student?"Giáo viên chưa mở bài. Bạn có thể học bài hoặc làm quiz trong lúc chờ.":"Bấm Giao bài mới để tạo đề và rubric."%></p></div><%}%>
<section class="surface"><h2><%=student?"Lịch sử nộp bài":"Danh sách bài nộp"%></h2><%List<Submission> subs=(List<Submission>)request.getAttribute("submissions");if(subs.isEmpty()){%><p>Chưa có bài nộp. Bài làm sẽ xuất hiện tại đây sau khi học sinh nộp.</p><%}for(Submission s:subs){%><div class="activity-row"><div><b><%=ViewSupport.h(s.assignment().title())%></b><p><%=student?"Bài làm của bạn":ViewSupport.h(s.email())%> · <%=s.visible()!=null?"Đã công bố":s.latest()!=null?"Đang rà soát":"Chờ chấm"%></p></div><a class="button secondary" href="<%=base%>/essays?submission=<%=s.id()%>"><%=student?"Xem bài / kết quả":"Xem và chấm"%></a></div><%}%></section><%}%>
<script src="${pageContext.request.contextPath}/assets/js/essay-photo.js?v=20261030-ux2" charset="UTF-8"></script>
<%@ include file="end.jspf" %>
