<%@ page pageEncoding="UTF-8" %>
<%CourseService placementStore=CourseService.getInstance();CourseService.Placement placement=entry==null?null:placementStore.placement(entry.id());String chosenChapter=error?request.getParameter("chapter"):placement==null?"":placement.chapter();%>
<div class="form-grid"><label>Khóa học / chương<select name="chapter" required><option value="">Chọn chương học</option><%for(CourseService.Chapter ch:placementStore.availableChapters(viewer)){%><option value="<%=ch.id()%>" <%=ch.id().equals(chosenChapter)?"selected":""%>><%=ViewSupport.h(com.smartstudy.service.CatalogService.getInstance().get(ch.course()).title()+" / "+ch.title())%></option><%}%></select></label><label>Thứ tự trong chương<input type="number" name="order" min="1" max="999" value="<%=ViewSupport.h(error?request.getParameter("order"):placement==null?1:placement.order())%>" required></label></div><label>Đường dẫn tài liệu / video (HTTPS, không bắt buộc)<input type="url" name="resourceUrl" maxlength="1000" value="<%=ViewSupport.h(error?request.getParameter("resourceUrl"):placement==null?"":placement.resourceUrl())%>"></label><p class="muted">Học sinh chỉ xem được học liệu khi đã tham gia khóa học được xuất bản. Quản lý chương ở trang Khóa học.</p>
