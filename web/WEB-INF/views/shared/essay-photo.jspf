<%@ page pageEncoding="UTF-8" %>
<section class="surface essay-photo-panel" aria-label="Ảnh bài làm">
<div class="essay-photo-heading"><div><span class="eyebrow">BÀI LÀM VIẾT TAY</span><h2><%=submission!=null?"Ảnh đã nộp":"Chụp hoặc tải ảnh bài làm"%></h2></div><span class="badge">JPEG · PNG</span></div>
<%if(essayPhoto!=null){%>
<div class="essay-photo-layout"><div><a href="${pageContext.request.contextPath}/media/essay-photo?id=<%=essayPhoto.id()%>" target="_blank" rel="noopener" aria-label="Mở ảnh bài làm kích thước lớn"><img class="essay-photo-original" src="${pageContext.request.contextPath}/media/essay-photo?id=<%=essayPhoto.id()%>" alt="Ảnh bài làm tự luận đã tải lên"></a><p class="field-help">Nhấn ảnh để xem lớn · <%=essayPhoto.width()%> × <%=essayPhoto.height()%> pixel</p></div>
<div><h3><%=essayPhoto.transcription()==null?"Đọc chữ và công thức trong ảnh":"Nội dung AI đọc được"%></h3>
<%if(essayPhoto.transcription()!=null){%><p class="field-help">Độ tin cậy nhận dạng: <%=Math.round(essayPhoto.confidence()*100)%>%. Hãy kiểm tra lại số, dấu và đơn vị.</p><%if(!essayPhoto.warning().isBlank()){%><div class="notice" role="status"><%=ViewSupport.h(essayPhoto.warning())%></div><%}%><textarea class="essay-ocr-text" rows="9" readonly aria-label="Nội dung nhận dạng từ ảnh"><%=ViewSupport.h(essayPhoto.transcription())%></textarea>
<%if(student&&submission==null&&!essayPhoto.transcription().isBlank()){%><button class="button secondary" type="button" data-ocr-insert>Chèn vào câu trả lời để kiểm tra</button><%}%>
<%}else if(submission==null||!student){%><p>Gemini đọc nội dung bài làm, giữ nguyên cách giải và lỗi sai. Ảnh mờ có thể cần chụp lại.</p><form method="post" action="<%=base%>/essay-photo" data-photo-action data-photo-scan><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="scan"><input type="hidden" name="photo" value="<%=essayPhoto.id()%>"><input type="hidden" name="draftAnswer"><label class="essay-photo-consent"><input type="checkbox" name="aiConsent" value="yes" required> Tôi đồng ý gửi vùng bài làm trong ảnh đến Google Gemini để nhận dạng. Ảnh không nên chứa thông tin cá nhân.</label><button class="button secondary" type="submit">Đọc ảnh bằng AI</button><span class="photo-progress" role="status" hidden>Đang đọc ảnh, vui lòng chờ…</span></form><%}else{%><p>Giáo viên có thể xem ảnh và yêu cầu AI hỗ trợ đọc, chỉ ra lỗi sai khi chấm bài.</p><%}%>
<%if(student&&submission==null){%><form method="post" action="<%=base%>/essay-photo" data-photo-action data-confirm="Gỡ ảnh nháp này? Bạn có thể tải lại ảnh khác trước khi nộp."><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="remove"><input type="hidden" name="photo" value="<%=essayPhoto.id()%>"><input type="hidden" name="draftAnswer"><button class="text-button" type="submit">Gỡ ảnh nháp để chọn ảnh khác</button></form><%}%>
</div></div>
<%}else if(student&&submission==null){%>
<p>Chụp rõ toàn bộ phần bài làm. Mỗi lần nộp có thể đính kèm một ảnh, tối đa 8 MB. Bạn có thể nộp ảnh trực tiếp hoặc dùng AI đọc chữ để bổ sung câu trả lời.</p>
<form method="post" action="<%=base%>/essay-photo" enctype="multipart/form-data" data-photo-upload data-photo-action>
<input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="upload"><input type="hidden" name="assignment" value="<%=assignment.id()%>"><input type="hidden" name="draftAnswer">
<div class="essay-photo-actions"><label class="photo-file-label">Chọn ảnh bài làm<input type="file" name="photoFile" accept="image/jpeg,image/png" required data-photo-file></label><button class="button secondary" type="button" data-camera-open>Chụp bằng camera</button></div>
<input type="file" accept="image/*" capture="environment" data-camera-file hidden aria-label="Chụp ảnh bằng camera điện thoại">
<div class="photo-preview" hidden><img alt="Xem trước ảnh sắp tải lên" data-photo-preview><button class="button secondary" type="button" data-photo-rotate>Xoay ảnh 90°</button></div>
<p class="field-help" data-photo-status role="status">Ảnh được lưu cùng bài nộp; chỉ bạn và giáo viên phụ trách xem được.</p><button class="button primary" type="submit">Lưu ảnh vào bài làm</button>
</form>
<dialog class="essay-camera" aria-labelledby="essay-camera-title"><h2 id="essay-camera-title">Chụp bài làm</h2><p>Đặt tờ giấy đủ sáng, chữ và công thức nằm trọn trong khung.</p><video autoplay playsinline muted aria-label="Xem trước camera"></video><p data-camera-status role="status"></p><div class="actions"><button class="button secondary" type="button" data-camera-close>Đóng camera</button><button class="button primary" type="button" data-camera-capture>Chụp và dùng ảnh</button></div></dialog>
<%}else{%><p>Bài này được nộp bằng văn bản.</p><%}%>
</section>
