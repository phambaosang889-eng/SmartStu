<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" import="com.smartstudy.model.*,com.smartstudy.service.QuizService" %><%@ include file="start.jspf" %>
<%boolean student=viewer.getRole()==Role.STUDENT;boolean teacher=viewer.getRole()==Role.TEACHER;QuizDefinition quiz=(QuizDefinition)request.getAttribute("quiz");QuizService.Run run=(QuizService.Run)request.getAttribute("quizRun");QuizService.Result result=(QuizService.Result)request.getAttribute("quizResult");boolean editing=!student&&("edit".equals(request.getParameter("mode"))||"save-quiz".equals(request.getParameter("action")));boolean formError=request.getAttribute("quizError")!=null;List<QuizDefinition> quizzes=(List<QuizDefinition>)request.getAttribute("quizzes");%>
<section class="page-heading"><div><span class="eyebrow">LUYỆN TẬP & ĐÁNH GIÁ</span><h1><%=result!=null?"Kết quả bài làm":run!=null?ViewSupport.h(run.quiz().title()):editing?"Biên soạn quiz":"Quiz Vật lý 10"%></h1><p><%=student?"Chọn bài kiểm tra, trả lời câu hỏi và xem lời giải sau khi nộp.":"Chọn câu hỏi, xem trước và phát hành quiz cho học sinh."%></p></div><%if(teacher&&!editing){%><a class="button primary" href="<%=base%>/quiz?mode=edit">＋ Tạo quiz</a><%}%></section>
<%if(formError){%><div class="notice error" role="alert"><%=ViewSupport.h(request.getAttribute("quizError"))%></div><%}%>
<%if(result!=null){%><div class="quiz-result"><span class="eyebrow">ĐÃ NỘP BÀI</span><h2><%=result.score()%> / <%=result.run().quiz().maxScore()%> điểm · <%=result.correct()%>/<%=result.run().quiz().questions().size()%> câu đúng</h2><p><%=result.expired()?"Bài nộp quá thời hạn. Điểm của lần làm này là 0.":"Kết quả đã được lưu. Tải lại trang sẽ không tạo thêm lần nộp."%></p><a class="button secondary" href="<%=base%>/quiz">Về danh sách quiz</a></div><%int qi=0;for(Question q:result.run().quiz().questions()){int answer=result.answers().get(qi++);%><article class="surface"><span class="badge"><%=answer==q.correctIndex()?"Trả lời đúng":"Cần ôn tập"%></span><h2><%=qi%>. <%=ViewSupport.h(q.text())%></h2><p>Bạn chọn: <b><%=answer<0?"Chưa trả lời":ViewSupport.h(q.options().get(answer))%></b></p><p>Đáp án đúng: <b><%=ViewSupport.h(q.options().get(q.correctIndex()))%></b></p><p><%=ViewSupport.h(q.explanation())%></p></article><%}%>
<%}else if(run!=null){%><div class="notice"><b>Thời gian còn lại: <span id="quiz-timer" data-deadline="<%=run.deadline().toEpochMilli()%>"></span></b><span>Bạn có thể nộp trước khi hết giờ. Câu chưa trả lời được tính 0 điểm.</span></div><nav class="actions" aria-label="Điều hướng câu hỏi"><%for(int i=0;i<run.quiz().questions().size();i++){%><a class="button secondary" href="#question-<%=i%>">Câu <%=i+1%></a><%}%></nav><form method="post" action="<%=base%>/quiz" id="quiz-run-form"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="submit"><input type="hidden" name="token" value="<%=run.token()%>"><%int i=0;for(Question q:run.quiz().questions()){%><article class="surface" id="question-<%=i%>"><h2><%=++i%>. <%=ViewSupport.h(q.text())%></h2><%for(int j=0;j<q.options().size();j++){%><label class="answer-option"><input type="radio" name="answer_<%=q.id()%>" value="<%=j%>"><span><%=ViewSupport.h(q.options().get(j))%></span></label><%}%><label class="check-line"><input type="checkbox" class="question-flag"> Đánh dấu để xem lại</label></article><%}%><button class="button primary" type="submit">Nộp bài và xem kết quả</button></form><script>(()=>{const timer=document.getElementById('quiz-timer'),form=document.getElementById('quiz-run-form');let sent=false;function tick(){const left=Math.max(0,Math.ceil((Number(timer.dataset.deadline)-Date.now())/1000));timer.textContent=Math.floor(left/60)+':'+String(left%60).padStart(2,'0');if(!left&&!sent){sent=true;form.requestSubmit()}}tick();setInterval(tick,1000);document.querySelectorAll('.question-flag').forEach(c=>c.addEventListener('change',()=>c.closest('article').classList.toggle('flagged',c.checked)));})();</script>
<%}else if(editing){String qt=formError?request.getParameter("title"):quiz==null?"":quiz.title();String qd=formError?request.getParameter("description"):quiz==null?"":quiz.description();String qm=formError?request.getParameter("minutes"):quiz==null?"10":String.valueOf(quiz.minutes());String qs=formError?request.getParameter("status"):quiz==null?"draft":quiz.status();List<String> checked=formError?(request.getParameterValues("question")==null?List.of():Arrays.asList(request.getParameterValues("question"))):quiz==null?List.of():quiz.questions().stream().map(Question::id).toList();%>
<form class="surface editor-form" method="post" action="<%=base%>/quiz" data-confirm="Lưu quiz với các câu hỏi đã chọn và trạng thái hiện tại?"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="save-quiz"><input type="hidden" name="id" value="<%=quiz==null?"":quiz.id()%>"><input type="hidden" name="version" value="<%=quiz==null?0:quiz.version()%>"><label>Tên quiz<input name="title" maxlength="150" value="<%=ViewSupport.h(qt)%>" required></label><label>Mô tả<textarea name="description" maxlength="1500" rows="3" required><%=ViewSupport.h(qd)%></textarea></label><div class="form-grid"><label>Thời gian (phút)<input type="number" name="minutes" min="1" max="180" value="<%=ViewSupport.h(qm)%>" required></label><label>Trạng thái<select name="status"><option value="draft" <%="draft".equals(qs)?"selected":""%>>Bản nháp</option><option value="published" <%="published".equals(qs)?"selected":""%>>Phát hành cho học sinh</option><option value="archived" <%="archived".equals(qs)?"selected":""%>>Lưu trữ</option></select></label></div><%@ include file="quiz-settings.jspf" %><h2>Chọn câu hỏi</h2><p>Chọn từ 1 đến 50 câu. Nội dung và đáp án dưới đây chính là bản xem trước trước khi lưu.</p><%List<Question> bank=(List<Question>)request.getAttribute("quizQuestions");for(Question q:bank){%><details class="question-choice" open><summary><%=ViewSupport.h(q.text())%></summary><label class="check-line"><input type="checkbox" name="question" value="<%=q.id()%>" <%=checked.contains(q.id())?"checked":""%>> Đưa câu này vào quiz</label><label>Thứ tự câu<input type="number" name="order_<%=q.id()%>" min="1" max="999" value="<%=bank.indexOf(q)+1%>"></label><ol><%for(String option:q.options()){%><li><%=ViewSupport.h(option)%></li><%}%></ol><p>Đáp án: <b><%=ViewSupport.h(q.options().get(q.correctIndex()))%></b> · <%=q.points()%> điểm</p><p><%=ViewSupport.h(q.explanation())%></p></details><%}%><div class="form-footer"><a class="button secondary" href="<%=base%>/quiz">Hủy</a><button class="button primary" type="submit">Lưu quiz</button></div></form>
<%}else if(quiz!=null){%><section class="surface"><span class="badge"><%=quiz.status().equals("published")?"Đã phát hành":quiz.status().equals("draft")?"Bản nháp":"Lưu trữ"%></span><h2><%=ViewSupport.h(quiz.title())%></h2><p><%=ViewSupport.h(quiz.description())%></p><p><%=quiz.questions().size()%> câu · <%=quiz.minutes()%> phút · <%=quiz.maxScore()%> điểm · <%=quiz.maxAttempts()==0?"Không giới hạn lần làm":quiz.maxAttempts()+" lần làm"%> · Hạn: <%=quiz.due()==null?"Không giới hạn":quiz.due()%></p><%if(student){%><form method="post" action="<%=base%>/quiz"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="id" value="<%=quiz.id()%>"><input type="hidden" name="action" value="start"><button class="button primary">Bắt đầu làm bài</button></form><%}else{%><%if(teacher){%><div class="actions"><a class="button primary" href="<%=base%>/quiz?mode=edit&id=<%=quiz.id()%>">Chỉnh sửa / phát hành</a><form method="post" action="<%=base%>/quiz"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="id" value="<%=quiz.id()%>"><input type="hidden" name="action" value="copy"><button class="button secondary">Sao chép</button></form></div><%}%><%for(Question q:quiz.questions()){%><div class="question-choice"><h3><%=ViewSupport.h(q.text())%></h3><ol><%for(String o:q.options()){%><li><%=ViewSupport.h(o)%></li><%}%></ol><p>Đáp án: <%=ViewSupport.h(q.options().get(q.correctIndex()))%></p><p><%=ViewSupport.h(q.explanation())%></p></div><%}}%></section>
<%}else{%><div class="toolbar"><label class="search-field"><span>⌕</span><input type="search" data-search aria-label="Tìm quiz" placeholder="Tìm theo tên quiz"></label><span data-result-count class="result-count"><%=quizzes.size()%> nội dung</span></div><div class="resource-grid"><%for(QuizDefinition q:quizzes){%><article class="resource-card" data-search-item><div class="card-top"><span class="resource-icon">?</span><span class="badge"><%=q.status().equals("published")?"Đã phát hành":q.status().equals("draft")?"Bản nháp":"Lưu trữ"%></span></div><h2><%=ViewSupport.h(q.title())%></h2><p><%=ViewSupport.h(q.description())%></p><div class="card-metric"><b><%=q.questions().size()%> câu</b><span>· <%=q.minutes()%> phút</span></div><a class="button secondary" href="<%=base%>/quiz?id=<%=q.id()%>"><%=student?"Mở bài kiểm tra →":"Xem trước / quản lý →"%></a></article><%}%></div><div class="empty-state" data-empty <%=quizzes.isEmpty()?"":"hidden"%>><h2>Chưa có quiz phù hợp</h2><p>Đổi từ khóa hoặc chờ giáo viên phát hành bài mới.</p></div><%List<QuizService.Result> history=(List<QuizService.Result>)request.getAttribute("quizHistory");if(!history.isEmpty()){%><section class="surface"><h2>Lịch sử làm bài</h2><%for(QuizService.Result r:history){%><div class="activity-row"><div><b><%=ViewSupport.h(r.run().quiz().title())%></b><p><%=student?"Bài làm của bạn":ViewSupport.h(r.run().email())%> · <%=r.score()%>/<%=r.run().quiz().maxScore()%></p></div><%if(student){%><a class="text-link" href="<%=base%>/quiz?run=<%=r.run().token()%>">Xem kết quả →</a><%}%></div><%}%></section><%}%><%}%><%@ include file="end.jspf" %>
