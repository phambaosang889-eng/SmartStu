<%@ page pageEncoding="UTF-8" %>
<div class="form-grid"><label>Khóa học<select name="course" required><option value="">Chọn khóa học phụ trách</option><%String selectedCourse=formError?request.getParameter("course"):quiz==null?"":com.smartstudy.service.CourseService.getInstance().courseOf(quiz.id());for(CatalogEntry c:com.smartstudy.service.CourseService.getInstance().courses(viewer)){%><option value="<%=c.id()%>" <%=c.id().equals(selectedCourse)?"selected":""%>><%=ViewSupport.h(c.title())%></option><%}%></select></label><label>Thời hạn (giờ Việt Nam, không bắt buộc)<input type="datetime-local" name="due" value="<%=ViewSupport.h(formError?request.getParameter("due"):quiz==null?"":quiz.due())%>"></label><label>Số lần làm (0: không giới hạn)<input type="number" name="maxAttempts" min="0" max="100" value="<%=ViewSupport.h(formError?request.getParameter("maxAttempts"):quiz==null?0:quiz.maxAttempts())%>" required></label><label>Tổng thang điểm<input type="number" name="maxScore" min="1" max="1000" value="<%=ViewSupport.h(formError?request.getParameter("maxScore"):quiz==null?100:quiz.maxScore())%>" required></label></div>
