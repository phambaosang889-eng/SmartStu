<%@ page pageEncoding="UTF-8" %>
<label>Nội dung câu hỏi<textarea name="question_<%=q.id()%>" maxlength="1000" required><%=ViewSupport.h(request.getAttribute("questionError")!=null&&request.getParameter("question_"+q.id())!=null?request.getParameter("question_"+q.id()):q.text())%></textarea></label><div class="form-grid"><%for(int oi=0;oi<q.options().size();oi++){%><label>Phương án <%=oi+1%><input name="option_<%=q.id()%>_<%=oi%>" maxlength="300" required value="<%=ViewSupport.h(request.getAttribute("questionError")!=null&&request.getParameter("option_"+q.id()+"_"+oi)!=null?request.getParameter("option_"+q.id()+"_"+oi):q.options().get(oi))%>"></label><%}%></div><div class="form-grid"><label>Đáp án đúng<select name="correct_<%=q.id()%>"><%for(int oi=0;oi<q.options().size();oi++){%><option value="<%=oi%>" <%=(request.getAttribute("questionError")!=null&&request.getParameter("correct_"+q.id())!=null?String.valueOf(oi).equals(request.getParameter("correct_"+q.id())):oi==q.correctIndex())?"selected":""%>><%=oi+1%></option><%}%></select></label><label>Mức độ<select name="level_<%=q.id()%>"><%for(String level:List.of("Nhận biết","Thông hiểu","Vận dụng","Vận dụng cao")){%><option <%=level.equals(request.getAttribute("questionError")!=null&&request.getParameter("level_"+q.id())!=null?request.getParameter("level_"+q.id()):q.difficulty())?"selected":""%>><%=level%></option><%}%></select></label><label>Điểm gợi ý<input name="points_<%=q.id()%>" type="number" min="1" max="10" value="<%=ViewSupport.h(request.getAttribute("questionError")!=null&&request.getParameter("points_"+q.id())!=null?request.getParameter("points_"+q.id()):q.points())%>" required></label></div><label>Lời giải và giải thích<textarea name="explanation_<%=q.id()%>" maxlength="2000" required><%=ViewSupport.h(request.getAttribute("questionError")!=null&&request.getParameter("explanation_"+q.id())!=null?request.getParameter("explanation_"+q.id()):q.explanation())%></textarea></label>
<div class="form-grid"><label>Độ khó<select name="hardness_<%=q.id()%>"><%for(String hardness:List.of("Dễ","Trung bình","Khó")){%><option <%=hardness.equals(q.hardness())?"selected":""%>><%=hardness%></option><%}%></select></label><label>Thời gian dự kiến (giây)<input name="seconds_<%=q.id()%>" type="number" min="15" max="600" required value="<%=q.seconds()%>"></label></div><p class="muted"><%=ViewSupport.h(q.lesson())%> · Mục tiêu: <%=ViewSupport.h(q.objective())%></p>