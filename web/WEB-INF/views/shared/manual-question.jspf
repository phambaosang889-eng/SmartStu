<%@ page pageEncoding="UTF-8" %>
<details class="surface"><summary class="text-link">＋ Tự biên soạn câu hỏi</summary><form class="editor-form" method="post" action="<%=base%>/question-bank"><input type="hidden" name="csrf" value="<%=ViewSupport.csrf(request)%>"><input type="hidden" name="action" value="manual-create"><label>Chủ đề<input name="topic" maxlength="80" required value="<%=ViewSupport.h(request.getParameter("topic"))%>"></label><label>Nội dung câu hỏi<textarea name="question_manual" maxlength="1000" rows="3" required><%=ViewSupport.h(request.getParameter("question_manual"))%></textarea></label><div class="form-grid"><%for(int mi=0;mi<4;mi++){%><label>Phương án <%=mi+1%><input name="option_manual_<%=mi%>" maxlength="300" required value="<%=ViewSupport.h(request.getParameter("option_manual_"+mi))%>"></label><%}%></div><div class="form-grid"><label>Đáp án đúng<select name="correct_manual"><%for(int mi=0;mi<4;mi++){%><option value="<%=mi%>"><%=mi+1%></option><%}%></select></label><label>Mức độ<select name="level_manual"><option>Nhận biết</option><option>Thông hiểu</option><option>Vận dụng</option></select></label><label>Điểm gợi ý<input type="number" name="points_manual" min="1" max="10" value="1" required></label></div><label>Lời giải<textarea name="explanation_manual" maxlength="2000" rows="4" required><%=ViewSupport.h(request.getParameter("explanation_manual"))%></textarea></label><button class="button primary">Thêm câu do giáo viên biên soạn</button></form></details>
