<%@ page pageEncoding="UTF-8" %>
<div class="split-grid"><%for(GrowthChart growth:(List<GrowthChart>)request.getAttribute("growthCharts")){%><section class="surface"><h2><%=ViewSupport.h(growth.title())%> · 7 ngày</h2><p>Số lượng được tạo theo từng ngày trong tuần.</p><div class="bar-chart" role="img" aria-label="<%=ViewSupport.h(growth.title())%>"><%for(ChartBar day:growth.bars()){%><div class="bar-column"><strong><%=day.count()%></strong><div class="bar-track"><div class="bar-fill" style="height:<%=day.percent()%>%"></div></div><span><%=day.day().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM"))%></span></div><%}%></div></section><%}%></div>
